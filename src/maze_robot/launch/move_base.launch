<launch>
	<node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" clear_params="true">
	    <rosparam file="$(find maze_robot)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
	    <rosparam file="$(find maze_robot)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
	    <rosparam file="$(find maze_robot)/param/local_costmap_params.yaml" command="load" />
	    <rosparam file="$(find maze_robot)/param/global_costmap_params.yaml" command="load" />
	    <rosparam file="$(find maze_robot)/param/teb_local_planner_params.yaml" command="load" />
	    <!-- 指定使用 TEB planner -->
	    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
	    
	    <!-- 恢复行为参数 -->
	    <param name="clearing_rotation_allowed" value="true" />
	    <param name="recovery_behavior_enabled" value="true" />
	    <param name="oscillation_timeout" value="10.0" />
	    <param name="oscillation_distance" value="0.2" />
	    <param name="planner_patience" value="5.0" />
	    <param name="controller_patience" value="10.0" />
	    <param name="conservative_reset_dist" value="0.3" />
	    <param name="controller_frequency" value="15.0" />
	    <param name="planner_frequency" value="1.0" />
	    <param name="make_plan_clear_costmap" value="true" />
	</node>
</launch>

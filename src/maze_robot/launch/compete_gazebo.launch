<launch>
    <!-- 加载机器人模型到参数服务器 -->
    <param name="robot_description" 
           command="$(find xacro)/xacro $(find maze_robot)/xacro/robot_gazebo.xacro" />

    <!-- 启动 Gazebo，加载比赛场地 world -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find maze_robot)/worlds/my_maze_map.world" />
        <arg name="paused" value="false" />
        <arg name="use_sim_time" value="true" />
        <arg name="gui" value="true" />
        <arg name="headless" value="false" />
        <arg name="debug" value="false" />
    </include>

    <!-- 在 Gazebo 中生成机器人，初始位置等 world 确认后再调整 -->
	<node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf" output="screen"
	      args="-param robot_description -urdf -model maze_robot
		    -x -2.176819186964238
		    -y 1.5817397325476588
 		    -z 0.05 
 		    -R 0.0 
 		    -P 0.0 
 		    -Y 0.0565" />

    <!-- 发布关节状态 -->
    <node pkg="joint_state_publisher" name="joint_state_publisher" 
          type="joint_state_publisher" />

    <!-- 发布机器人TF树 -->
    <node pkg="robot_state_publisher" name="robot_state_publisher" 
          type="robot_state_publisher">
        <param name="publish_frequency" value="50.0" />
    </node>
</launch>

<launch>
    <!-- 将 Urdf 文件的内容加载到参数服务器 -->
    <param name="robot_description" command="$(find xacro)/xacro $(find maze_robot)/xacro/robot_gazebo.xacro" />
    
    <!-- 启动 gazebo 空世界 -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch" />

    <!-- 在 gazebo 中显示机器人模型 -->
    <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf" 
          args="-param robot_description -urdf -model maze_robot -x 0 -y 0 -z 0" />
</launch>
